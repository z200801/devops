# Registration token from Gitea Site Administration > Actions > Runners
TOKEN=<registration-token>

# URL of the Gitea instance this runner connects to
GITEA_INSTANCE_URL=https://gitea.example.com

# Display name for this runner
RUNNER_NAME=gitea-runner

# Labels advertised at registration time (comma-separated)
GITEA_RUNNER_LABELS=ubuntu-latest:docker://gitea/runner-images:ubuntu-latest,ubuntu-22.04:docker://gitea/runner-images:ubuntu-22.04
