# PostgreSQL credentials
POSTGRES_USER=gitea
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gitea

# Gitea server
ROOT_URL=https://gitea.example.com
TZ=UTC
USER_UID=1000
USER_GID=1000

# Traefik — domain and TLS
DOMAIN=gitea.example.com
HTTPS_PORT=443
SSH_PORT=2221
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
