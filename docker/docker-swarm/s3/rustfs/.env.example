# Copy to .env and fill in real values before deploying.
# Real .env is gitignored — never commit credentials.

# Credentials are managed via Docker secrets (make secret-create).
# They are NOT stored in .env — see README §Create Docker secrets.

# Log level for RustFS (debug|info|warn|error)
RUSTFS_OBS_LOGGER_LEVEL=warn

# Host names routed by Traefik to RustFS (set in your upstream DNS / /etc/hosts)
S3_HOST=s3.example.local
CONSOLE_HOST=console.s3.example.local

# Host ports published by Traefik (must be free on the node; avoid 80/443 — used by host proxy)
WEB_PORT=19000
WEBSECURE_PORT=19001

# Upstream proxy IP that Traefik sees as the peer (Docker ingress/gateway address,
# NOT the nginx LAN IP). Measure after first deploy:
#   docker service logs rustfs_traefik | grep -i clientaddr
# Then update traefik_config/traefik.yml trustedIPs with the real CIDR and run make deploy.
TRUSTED_PROXY_IPS=10.0.0.0/8
